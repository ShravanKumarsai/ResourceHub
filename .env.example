# Public Supabase client settings. Replace these with values from your project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional table used by the development-only, read-only connection check.
# Create this table with a SELECT policy before expecting a successful result.
SUPABASE_CONNECTION_TEST_TABLE=resourcehub_connection_test

# Optional server-only notification delivery. Leave blank to keep outbound
# email and push delivery disabled.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# VAPID public key is safe to expose; keep the private key server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
